{
  "name": "trombone",
  "version": "1.1.1",
  "description": "Lecteur et éditeur PDF gratuit pour Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test-ops.js && node test/test-office.js && node test/test-real.mjs",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "build:web": "node scripts/build-web.js",
    "postinstall": "node scripts/prepare-ocr.js"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "private": true,
  "build": {
    "appId": "fr.trombone.pdf",
    "productName": "Trombone",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "vendor/**/*",
      "fonts/**/*",
      "ocr/**/*",
      "samples/**/*",
      "!src/platform-web.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Trombone-Installation-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "Trombone-Portable-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "asar": true
  },
  "author": "Berners",
  "license": "MIT"
}
